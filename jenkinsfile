pipeline {
    agent agent1

    stages {
        stage('Run in container') {
            steps {
                script {
                    docker.image('busybox').inside('-v /run/desktop/mnt/host/d/webDev/jenkins/jenkins_output:/output') {
                        sh 'echo "Hello from withDockerContainer" > /output/hello.txt'
                    }
                }
            }
        }
    }
}